# Public Firebase web app configuration (not a service account)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Vercel server variables ONLY. Never use VITE_ for secrets.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Comma-separated Firebase Auth UIDs allowed to edit and publish content.
# Leave empty to disable online content editing. Requires verified email.
CONTENT_EDITOR_UIDS=
